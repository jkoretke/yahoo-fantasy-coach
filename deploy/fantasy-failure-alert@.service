[Unit]
Description=Email alert when a Yahoo Fantasy Coach unit fails at the systemd level
# Reached from every routine unit below via OnFailure=fantasy-failure-alert@%n.service,
# so %i here is the name of the unit that failed. This fires ONLY when the wrapper
# itself could not report: it was killed at TimeoutStartSec, or an ExecStartPre failed.
# It also fires when a wrapper reports its own failure, since a "failed" STATUS line
# now exits 1. A successful or legitimately skipped run exits 0 and never reaches here.
# Note: engine.notify's CLI always exits 0, so this alert unit reports success even
# when it could not actually send the email. journalctl -u fantasy-failure-alert@<unit>
# is the only durable record that it ran and what it printed.

[Service]
Type=oneshot
User=jeff
WorkingDirectory=/home/jeff/Projects/yahoo-fantasy-coach
Environment=HOME=/home/jeff
Environment=PATH=/home/jeff/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/jeff/Projects/yahoo-fantasy-coach/.venv/bin/python3 -m engine.notify --subject "[fantasy-coach] FAILED: systemd could not run %i" --body "%i entered a failed state, so no routine email was sent. Check: journalctl -u %i -n 100"
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
