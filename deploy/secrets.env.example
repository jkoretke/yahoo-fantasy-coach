# Copy to ~/.config/yahoo-fantasy-coach/secrets.env on the box, then:
#   chmod 700 ~/.config/yahoo-fantasy-coach
#   chmod 600 ~/.config/yahoo-fantasy-coach/secrets.env
# Read by engine.common.load_secrets. Never commit real values.
#
# Yahoo developer app credentials. See README.md, "Yahoo API setup".
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Only needed when config/league.yaml sets email.backend: brevo.
BREVO_API_KEY=
